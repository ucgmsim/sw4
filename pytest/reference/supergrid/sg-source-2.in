# Same geometry as sg-source-1, but 'developer allowsourceinsupergrid=1'
# downgrades the abort to a warning. The full diagnostic must still print.
fileio path=sg-source-2
developer allowsourceinsupergrid=1
grid x=6000 y=6000 z=4000 h=100
time steps=2
supergrid gp=10
block vp=6000 vs=3464 rho=2700
source x=800 y=3000 z=1500 mxy=1e18 t0=0.1 freq=5 type=Gaussian
rec x=3000 y=3000 z=0 sta=interior file=interior usgsformat=1 sacformat=0
