# eq.in with the grid command's projection options as a parameter (see default-projection.toml).
fileio verbose=1
developer cfl=0.9 failonnan=1
grid {{gridproj}} x={{L}} y={{L}} z={{Z}} h={{h}} az={{az}} lon={{lon0}} lat={{lat0}}
time t={{t}}
supergrid {{sg}}
{{topo}}
{{material}}
{{source}}
rechdf5 infile=stations.h5 outfile=out.h5 {{recvars}}
{{rec}}
